                <div class="newsletter-checkbox">
                    <input type="checkbox" id="privacy-check" required>
                    <label for="privacy-check">
                        Acconsento al trattamento dei miei dati in conformità all'Informativa Privacy per l'invio di newsletter.
                    </label>
                </div>
                
                <button type="submit" class="btn-submit-outline">Invia</button>
            </form>

            <div id="successMessage" class="success-box">
